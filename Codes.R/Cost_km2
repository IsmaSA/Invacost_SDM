         world1$ISO3 <- as.factor(world1$ISO3)
        world1 <- world1 %>%  mutate(COUNTRYAFF_NUM = as.numeric(as.factor(COUNTRYAFF)))
        
       world1 <- st_transform(world1, crs = crs(prediction_raster))   # We need to have the same crs
       r_country <- prediction_raster  %>%  mask(world1)

        total_prob <- sum(r_country[], na.rm = TRUE)
        
        country_cost <- species_country$Total.cost 
        
        cost_distribution <- r_country
        values(cost_distribution) <- ifelse(!is.na(values(cost_distribution)), (values(cost_distribution) / total_prob) * country_cost, NA)
        
        # Add this species' cost distribution to the cumulative cost raster
        cumulativeCostRaster <- cumulativeCostRaster + replace(cost_distribution, is.na(values(cost_distribution)), 0)

      }
