# Loop part: 
spn <- unique(df1$Species) # unique species for the loop 
n <- spn[1]

Cost_km2_total <- data.frame()

for (n in spn) {
    print(n)
  df2 <- df1[df1$Species == n, ] # Costs of the given species
  countries <- unique(df2$ISO3) # Countries where the species has costs  (we used ISO codes)
  
  raster_file <- paste0("prediction_prediction_", n, ".tif.tif") # This is the name of the SDMs I have --- yes it has two.tif
  raster_path <- file.path("C:/Users/IsmaSA/Desktop/My projects/Brian/Revision_results/Raster_model_Ensemble", raster_file)
  
  if (file.exists(raster_path)) { 
    prediction_raster <- raster(raster_path)
#    plot(prediction_raster)    # See the SDMs


    for (country in countries) {  # Now we interate for each country where the species has costs
      species_country <- df2[df2$ISO3 == country, ]  # Here we have the unique combinations species-country
      
      world1 <- world %>% filter(ISO3 == country) # Filter the world map to have only the country 
     #  plot(world1)

      if (nrow(world1) > 0) {
        world1$ISO3 <- as.factor(world1$ISO3)
        world1 <- world1 %>%
          mutate(COUNTRYAFF_NUM = as.numeric(as.factor(COUNTRYAFF)))
        
       world1 <- st_transform(world1, crs = crs(prediction_raster))   # We need to have the same crs
       r_country <- prediction_raster %>%  crop(world1) %>%  mask(world1)
      # plot(r_country) # This show just the country we are working on 

      country_values <- getValues(r_country)
      # range(country_values, na.rm=T)  # the values of the country
      
       # Now we calculate the cost per km2
       Area_cell <- 8.3*8.3 # aprox to my res 0.08 

       suitability_sum <- sum(country_values, na.rm = TRUE)
       suitable_area_km2 <- suitability_sum * Area_cell  # area suitable in km2

       cost_total <- species_country$Billion * 1e9  # Cost of the species in the country
       Cost_km2 <- cost_total / suitable_area_km2
          
          Cost_per_km2 <- data.frame(Cost.km2 = Cost_km2)
        Cost_per_km2$Total.cost <-  species_country$Billion * 1e9 
           Cost_per_km2$species <- n
          Cost_per_km2$ISO <- country
        Cost_per_km2$Country  <- species_country$Official_country
        Cost_per_km2$suitability.sum.cells  <- suitability_sum
        Cost_per_km2$suitable_area_km2  <- suitable_area_km2

        Cost_km2_total <- rbind(Cost_km2_total, Cost_per_km2)
     
      }
    }
}
}

