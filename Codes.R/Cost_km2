  df1 <- all1[all1$species == n, ]
  countries <- unique(df1$ISO3)
  
  raster_file <- paste0("prediction_prediction_", n, ".tif.tif") # This is the name of the SDMs I have --- yes it has two.tif
  raster_path <- file.path("C:/Users/IsmaSA/Desktop/My projects/Brian/Revision_results/Raster_model_Ensemble", raster_file)

  if (file.exists(raster_path)) {
